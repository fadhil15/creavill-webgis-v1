{
    "kind": "collectionType",
    "collectionName": "geojson_layers",
    "info": {
        "singularName": "geojson-layer",
        "pluralName": "geojson-layers",
        "displayName": "GeoJSON Layer",
        "description": "Layer GeoJSON untuk WebGIS (polygon, line, point)"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "layerType": {
            "type": "enumeration",
            "enum": [
                "boundary",
                "roads",
                "tourism",
                "minimarket",
                "resto",
                "education",
                "health",
                "government",
                "other"
            ],
            "required": true
        },
        "geojsonData": {
            "type": "json",
            "required": true
        },
        "style": {
            "type": "json"
        },
        "legendLabel": {
            "type": "string"
        },
        "legendColor": {
            "type": "string",
            "default": "#3b82f6"
        },
        "legendType": {
            "type": "enumeration",
            "enum": [
                "point",
                "line",
                "line-dashed",
                "line-thick",
                "polygon"
            ]
        },
        "isVisible": {
            "type": "boolean",
            "default": true
        },
        "sortOrder": {
            "type": "integer",
            "default": 0
        },
        "village": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::village.village"
        }
    }
}