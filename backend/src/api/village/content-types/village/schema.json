{
    "kind": "collectionType",
    "collectionName": "villages",
    "info": {
        "singularName": "village",
        "pluralName": "villages",
        "displayName": "Desa",
        "description": "Desa binaan CreaVill Bandung untuk WebGIS"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "name"
        },
        "description": {
            "type": "text"
        },
        "center": {
            "type": "json",
            "required": true
        },
        "zoom": {
            "type": "integer",
            "default": 14
        },
        "legendColor": {
            "type": "string",
            "default": "#3b82f6"
        },
        "isActive": {
            "type": "boolean",
            "default": true
        },
        "coverImage": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        }
    }
}